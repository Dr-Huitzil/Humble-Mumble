# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments & IDEs
.venv/
venv/
ENV/
.vscode/
.idea/
*.swp
*.sublime-*

# Windows & OS artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary & Lock files
~$*.xlsx
*.tmp
*.log

# Sensitive Google OAuth Credentials & Tokens (Never commit real credentials)
credentials*.json
*credentials*.json
token*.json
*token*.json
client_secret*.json

# Local organization overrides & Google Sheets configuration
google_sheets_config*.json
organization_config*.json
*config*.local.json
.env
.env.*
.env.local

# Generated Excel & CSV Reports
reports/**/*.xlsx
reports/**/*.csv
reports/**/raw report/
*.xlsx

# Local Data Dumps (Protect proprietary fleet data)
data/
archive/
Computers_Raw_*.csv
*device_details*.csv
*custom_fields*.csv
*huntress*.csv
*.csv

# Whitelist synthetic mock samples & folder markers
!samples/*.csv
!reports/**/.gitkeep
